NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
ARCGIS_SESSION_SECRET=

# S3-compatible object storage (Supabase S3 in dev, Backblaze B2 in prod)
# Dev example:  https://your-project.storage.supabase.co/storage/v1/s3
# Prod example: https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=client-documents
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# What password will admin@example.com have? Leave it as 'admin' only for development purposes
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Dedicated persistent tester account for automated test suites
TEST_ADMIN_EMAIL=tester@example.com
TEST_ADMIN_PASSWORD=tester123!

# Optional: Production database credentials for `npm run seed:production` (if not supplied interactively)
# PROD_SUPABASE_URL=https://your-production-project.supabase.co
# PROD_SUPABASE_SECRET_KEY=abcdef1234
# PROD_ADMIN_PASSWORD=admin@example.com
# PROD_ADMIN_EMAIL=admin