NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
ARCGIS_SESSION_SECRET=

# What password will admin@example.com have? Leave it as 'admin' only for development purposes
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Optional: Production database credentials for `npm run seed:production` (if not supplied interactively)
# PROD_SUPABASE_URL=https://your-production-project.supabase.co
# PROD_SUPABASE_SECRET_KEY=abcdef1234
# PROD_ADMIN_PASSWORD=admin@example.com
# PROD_ADMIN_EMAIL=admin